# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finances"

# JWT Secret (mude para uma chave segura em produção)
# OBRIGATÓRIO — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# OBRIGATÓRIO — origens permitidas no CORS (separadas por vírgula)
# Exemplo: https://app.stratto.com,https://www.stratto.com
ALLOWED_ORIGINS="http://localhost:3000"

# Server
PORT=3001
NODE_ENV=development

# Supabase Auth
# Use o projeto Supabase correspondente a este ambiente.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY=""

# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_SUBJECT="mailto:seu-email@exemplo.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
